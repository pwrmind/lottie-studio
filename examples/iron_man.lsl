-- ============================================================================
-- ТАЙМЛАЙН: ПОСЛОЙНАЯ СБОРКА КОМПОЗИЦИИ + ДВИЖЕНИЕ КАМЕРЫ
-- ============================================================================
AT 0.2 UPDATE layers SET opacity = 100 WHERE id LIKE 'l1_%' WITH (duration = 0.4, ease = 'out');
AT 0.5 UPDATE layers SET opacity = 100 WHERE id LIKE 'l2_%' WITH (duration = 0.4, ease = 'out');
AT 0.8 UPDATE layers SET opacity = 100 WHERE id LIKE 'l3_%' WITH (duration = 0.4, ease = 'out');
AT 1.1 UPDATE layers SET opacity = 100 WHERE id LIKE 'l4_%' WITH (duration = 0.45, ease = 'out');
AT 1.5 UPDATE layers SET opacity = 100 WHERE id LIKE 'l5_%' WITH (duration = 0.4, ease = 'out');
AT 1.8 UPDATE layers SET opacity = 100 WHERE id LIKE 'l6_%' WITH (duration = 0.45, ease = 'out');
AT 2.2 UPDATE layers SET opacity = 100 WHERE id LIKE 'l7_%' WITH (duration = 0.35, ease = 'out');

-- После сборки — плавный наезд камеры на шлем и глаза [3.4 — 6.8s]
AT 3.4 UPDATE camera SET x = 274, y = 260, zoom = 1.85 WITH (duration = 1.4, ease = [0.22, 1, 0.36, 1]);

-- Резкий монтажный кат на крупный план глаз [6.8 — 9.2s]
AT 6.8 UPDATE camera SET x = 272, y = 244, zoom = 3.2;
AT 6.85 UPDATE camera SET x = 272, y = 244, zoom = 3.45 WITH (duration = 2.2, ease = 'linear');

-- Возврат на общий план постера [9.2 — 12.0s]
AT 9.2 UPDATE camera SET x = 270, y = 480, zoom = 1.0 WITH (duration = 1.2, ease = [0.22, 1, 0.36, 1]);
