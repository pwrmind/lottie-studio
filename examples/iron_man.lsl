-- ============================================================================
-- 🦾 IRON MAN — ПОСТЕР В СТИЛЕ POP-ART / HOPE (ПОСЛОЙНАЯ СБОРКА В LSL)
-- Формат: 540x960 (9:16), 60 fps, длительность 12.0 с
-- Палитра: #F4EBD9 (крем), #D32F2F (алый), #7899A6 (стальной), #111111 (тушь)
-- ============================================================================

UPDATE composition SET width = 540, height = 960, fps = 60, duration = 12.0;

AT 0.0 UPDATE camera SET x = 270, y = 480, zoom = 1.0;

-- ============================================================================
